      { "id": "dims-together", "when": { "any": [{ "param": "width", "op": "present" }, { "param": "height", "op": "present" }] }, "then": [{ "op": "required", "param": "width" }, { "op": "required", "param": "height" }], "message": { "en": "Set both width and height.", "tr": "Genişlik ve yüksekliği birlikte ayarlayın." } }

{
  "name": "vidra-studio",
  "private": true,
  "version": "0.1.3",
  "description": "Vidra Studio — independent open-source AI video and image creation desktop app. By Tolga İleri.",
  "license": "MIT",
  "author": "Tolga İleri",
  "repository": { "type": "git", "url": "https://github.com/tolga-ileri/vidra-studio.git" },
  "packageManager": "pnpm@12.9.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @vidra/desktop tauri dev",
    "build": "pnpm --filter @vidra/desktop tauri build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:rust": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:rust"
  }
}
